# -*-zsh-*- vim:ft=zsh

# ░█░█░█▀▄░█▀▀░░░█▀▄░█▀█░█▀▀░█▀▀░░░█▀▄░▀█▀░█▀▄
# ░▄▀▄░█░█░█░█░░░█▀▄░█▀█░▀▀█░█▀▀░░░█░█░░█░░█▀▄
# ░▀░▀░▀▀░░▀▀▀░░░▀▀░░▀░▀░▀▀▀░▀▀▀░░░▀▀░░▀▀▀░▀░▀

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

# npm
export npm_config_userconfig="$XDG_CONFIG_HOME/npmrc"

# Yarn
export YARN_CACHE_FOLDER="$XDG_CACHE_HOME/yarn"
export YARN_GLOBAL_FOLDER="$XDG_DATA_HOME/yarn"

# Rust
export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export CARGO_HOME="$XDG_DATA_HOME/cargo"

# NCurses
export TERMINFO="$XDG_DATA_HOME/terminfo"
export TERMINFO_DIRS="$XDG_DATA_HOME/terminfo:/usr/share/terminfo"

# Go
export GOPATH="$XDG_DATA_HOME/go"

# WGet
export WGETRC="$XDG_CONFIG_HOME/wgetrc"

# Node
export NODE_REPL_HISTORY="$XDG_DATA_HOME/node_repl_history"

# Wakatime
export WAKATIME_HOME="$XDG_CONFIG_HOME/wakatime"

# PM2
export PM2_HOME="$XDG_CACHE_HOME/pm2"

# PostgreSQL
export PSQLRC="$XDG_CONFIG_HOME/pg/psqlrc"
export PGPASSFILE="$XDG_CONFIG_HOME/pg/pgpass"
export PSQL_HISTORY="$XDG_STATE_HOME/psql_history"
export PGSERVICEFILE="$XDG_CONFIG_HOME/pg/pg_service.conf"

# Zsh history
export HISTFILE="$XDG_STATE_HOME/zsh/history"

# CUDA
export CUDA_CACHE_PATH="$XDG_CACHE_HOME/nv"

# Harmonoid
export HARMONOID_CACHE_DIR="$XDG_CACHE_HOME/harmonoid"

# ░█▀█░█▀█░▀█▀░█░█░█▀▀
# ░█▀▀░█▀█░░█░░█▀█░▀▀█
# ░▀░░░▀░▀░░▀░░▀░▀░▀▀▀

typeset -U path

# Make Homebrew PATH available
for brew in {/opt/homebrew,/usr/local,$HOME/.linuxbrew,/home/linuxbrew/.linuxbrew}/bin/brew(N-*); do
  eval "$("$brew" shellenv)"
  break
done

# Custom path — zsh-native tied array: $path syncs to $PATH automatically
path=(
  "$HOME/.local/bin"(N-/)
  "${XDG_DATA_HOME:-$HOME/.local/share}/mise/shims"(N-/)
  $path
)

# Node global module require path
if (( $+commands[node] )); then
  export NODE_PATH="${commands[node]:A:h:h}/lib/node_modules"
fi

# ░█▀▄░█▀▀░█▀▀░█▀█░█░█░█░░░▀█▀░█▀▀
# ░█░█░█▀▀░█▀▀░█▀█░█░█░█░░░░█░░▀▀█
# ░▀▀░░▀▀▀░▀░░░▀░▀░▀▀▀░▀▀▀░░▀░░▀▀▀

# Editor selection
if [[ "${TERM_PROGRAM:-tty}" == *vscode* ]]; then
  export VISUAL="code --wait"
  export EDITOR="code --wait"
else
  export VISUAL=nvim
  export EDITOR=nvim
fi

if (( $+commands[hostnamectl] )) && [[ "$(hostnamectl chassis 2>/dev/null)" == 'server' ]]; then
  export BROWSER=lynx
fi

# ░▀█▀░█░█░█▀▀░█▀█░█░█░█▀▀
# ░░█░░█▄█░█▀▀░█▀█░█▀▄░▀▀█
# ░░▀░░▀░▀░▀▀▀░▀░▀░▀░▀░▀▀▀

# fzf configs
if (( $+commands[fzf] )); then
  # Catppuccin Mocha colors
  export FZF_DEFAULT_OPTS="--border --tabstop=2 \
    --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
    --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
    --color=marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"

  if (( $+commands[fd] )); then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow'

    _fzf_compgen_path() {
      fd --hidden --follow . "$1"
    }

    _fzf_compgen_dir() {
      fd --type d --hidden --follow . "$1"
    }

    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  fi
fi

# Invoking gpg-agent — interactive terminals only
if [[ -o interactive ]]; then
  export GPG_TTY="$TTY"
fi

# Batman syntax highlight for man pages
if (( $+commands[bat] )); then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  export MANROFFOPT="-c"
fi

# Misc flags
export LESS='--RAW-CONTROL-CHARS --ignore-case'
export FORCE_COLOR=true

# ░█▀█░█▀▄░▀█▀░█░█░█▀█░▀█▀░█▀▀░░░█▀▀░█▀█░█░█
# ░█▀▀░█▀▄░░█░░▀▄▀░█▀█░░█░░█▀▀░░░█▀▀░█░█░▀▄▀
